{
  "manifest_version": 1,
  "key": "com.multica.wakeup-for-sub-issue",
  "name": "Wakeup for sub-issue",
  "description": "Wake the parent when all children finish, or a child needs review or becomes blocked.",
  "version": "1.0.3",
  "author": { "name": "Multica" },
  "scopes": ["host:exec", "issues:read", "storage:workspace"],
  "config": {
    "all_finished_prompt": { "type": "string", "label": "All sub-issues finished prompt", "multiline": true, "required": true },
    "in_review_prompt": { "type": "string", "label": "Sub-issue in review prompt", "multiline": true, "required": true },
    "blocked_prompt": { "type": "string", "label": "Sub-issue blocked prompt", "multiline": true, "required": true }
  },
  "contributes": {
    "hooks": [
      {
        "key": "all_finished", "name": "All sub-issues finished", "description": "Bring the child results back to the parent.",
        "triggers": ["event", "manual"], "events": ["issue.created", "issue.updated", "issue.status_changed"],
        "timeout_ms": 30000, "transport": { "type": "exec", "entry": "hook.py" }
      },
      {
        "key": "in_review", "name": "Sub-issue in review", "description": "Ask the parent to review a child's result.",
        "triggers": ["event", "manual"], "events": ["issue.created", "issue.updated", "issue.status_changed"],
        "timeout_ms": 30000, "transport": { "type": "exec", "entry": "hook.py" }
      },
      {
        "key": "blocked", "name": "Sub-issue blocked", "description": "Ask the parent to resolve a child's blocker.",
        "triggers": ["event", "manual"], "events": ["issue.created", "issue.updated", "issue.status_changed"],
        "timeout_ms": 30000, "transport": { "type": "exec", "entry": "hook.py" }
      }
    ]
  }
}
